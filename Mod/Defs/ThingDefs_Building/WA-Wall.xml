  <!--========================= WA-CastleGate =============================-->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>WA_Gate_CastleGate</defName>
    <label>Castle Gate</label>
    <description>The castle gate was one of the few places to enter the castle and it was one of the most important defense lines at wartime.
For that reason, it was easy to make a robust structure that can not be withdrawn, and a lot of ingenious efforts were made for interception.</description>
	<building>
	    <blueprintGraphicData>
	      <texPath>Things/Building/Gate/WA-Gate-CastleGate-blueprint</texPath>
	    </blueprintGraphicData>
    </building>
	<uiIconPath>Things/Building/Gate/WA-Gate-CastleGate-i</uiIconPath>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>Standable</passability>
    <canOverlapZones>true</canOverlapZones>
    <graphicData>
      <texPath>Things/Building/Gate/WA-Gate-CastleGate</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
	  <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>1.0</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>300</Mass>
      <Flammability>0</Flammability>
      <Beauty>10</Beauty>
    </statBases>
    <size>(1,1)</size>
    <holdsRoof>false</holdsRoof>
    <blockLight>false</blockLight>
	<blockWind>false</blockWind>
    <stuffCategories>
