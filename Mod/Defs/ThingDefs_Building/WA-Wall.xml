      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>0.5</multiplier>
      </li>
    </damageMultipliers>
    <researchPrerequisites>
      <li>WA_Research_Building_Castle</li>
    </researchPrerequisites>
    <designationCategory>WA_Builder</designationCategory>
  </ThingDef>

  <!--========================= WA-Wall-Kawara =============================-->
  <ThingDef ParentName="WA_WallKawaraBase">
    <defName>WA_Wall_Kawara</defName>
    <label>Rampart</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
	<drawerType>MapMeshAndRealTime</drawerType>
    <description>It is a type of painted wall.
The roof tiles(Kawara) roofed on the plastics wall also combine rain removal and decoration.
At that time the tiles were expensive, mainly used for the outer walls of samurai residences.</description>
    <graphicData>
      <texPath>Things/Building/Wall/WA-Wall-Kawara</texPath>
      <graphicClass>Graphic_Single</graphicClass>
