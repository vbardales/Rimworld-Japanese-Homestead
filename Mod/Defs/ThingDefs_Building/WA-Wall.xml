	<designationCategory>WA_Builder</designationCategory>
    <researchPrerequisites>
      <li>WA_Research_Building_Castle</li>
    </researchPrerequisites>
  </ThingDef>

  <!--========================= IronGate =============================-->
  <ThingDef ParentName="BuildingBase">
    <defName>WA_Gate_IronGate</defName>
    <label>Castle Door</label>
    <description>The castle gate was one of the few places to enter the castle and it was one of the most important defense lines at wartime.
Some of the gate is made of heavy iron, and even just opening it required a very large effort.</description>
    <thingClass>Building_Door</thingClass>
    <category>Building</category>
    <altitudeLayer>DoorMoveable</altitudeLayer>
	<uiIconPath>Things/Building/Gate/WA-Gate-IronGate-i</uiIconPath>
