	</statBases>
    <fillPercent>1</fillPercent>
  </ThingDef>

  <!--========================= WA-Wall-StoneWall =============================-->
  <ThingDef ParentName="BuildingBase">
    <defName>WA_Wall_StoneWall</defName>
    <label>Stone Wall</label>
    <description>Ishigaki is a wall created by assembling stones and rocks, and is mainly used as a defense such as a castle.
Initially it was just a stack of natural stones, but as the era has progressed, things that increased the defensibility by loading stones machined without gaps became mainstream.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Security/WA-WALL-StoneWall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <shaderType>CutoutComplex</shaderType>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Sandbags</li>
      </linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Security/WA-WALL-StoneWall-i</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>400</pathCost>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Beauty>2</Beauty>
      <WorkToBuild>300</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <building>
		<ai_chillDestination>false</ai_chillDestination>
		<isInert>true</isInert>
    	<blueprintGraphicData>
			<texPath>Things/Building/Security/WA-WALL-StoneWall-blueprint</texPath>
		</blueprintGraphicData>
    </building>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>6</costStuffCount>
    <filthLeaving>SandbagRubble</filthLeaving>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <designationCategory>WA_Builder</designationCategory>
    <damageMultipliers>
      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>0.5</multiplier>
      </li>
    </damageMultipliers>
    <researchPrerequisites>
      <li>WA_Research_Building_Castle</li>
    </researchPrerequisites>
  </ThingDef>



