  <!--========================= WA-Wall-WaterMoats =============================-->
  <ThingDef ParentName="WA_MoatsBuildingBase">
    <defName>WA_Wall_WaterMoats</defName>
    <label>Water Moats</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
	<drawerType>MapMeshAndRealTime</drawerType>
    <description>The moat was dug around the castle and temple from the ancient times to prevent invasion of enemies and animals.
It has width and depth that can not easily be exceeded and it functions as an important defense facility.
Those water-trenched to the moat are called Mizuhori in particular, and have been incorporated into many castles since the modern era.</description>
    <graphicData>
      <texPath>Things/Building/Wall/WA-Wall-WaterMoats</texPath>
    </graphicData>	
    <uiIconPath>Things/Building/Wall/WA-Wall-WaterMoats-i</uiIconPath>
