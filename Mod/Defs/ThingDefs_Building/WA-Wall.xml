  </ThingDef>

  <!--========================= WA-Wall-Demado =============================-->
  <ThingDef ParentName="WA_WallKawaraBase">
    <defName>WA_Wall_Demado</defName>
    <label>Rampart(bay window)</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
	<drawerType>MapMeshAndRealTime</drawerType>
    <description>It is one with a bay window attached to the wall with tiles.
The bay window functioned as a surveillance window besides the role of giving aesthetic appearance during normal times.
In addition, it fulfills the role of firearms and stone drops at wartime.</description>
