  <!--========================= WA-Step =============================-->
  <ThingDef ParentName="WA_MoatsBuildingBase">
    <defName>WA_Step</defName>
    <label>Step</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
	<drawerType>MapMeshAndRealTime</drawerType>
    <description>The staircase is a structure to move to a place with a height difference.
It is divided into several horizontal stages with a height that can be raised and lowered by human feet.
Rimworld without the notion of step difference has no meaning other than appearance.</description>
    <graphicData>
      <drawSize>(3,1)</drawSize>
      <linkType>None</linkType>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Step/WA-Garden-Step</texPath>
