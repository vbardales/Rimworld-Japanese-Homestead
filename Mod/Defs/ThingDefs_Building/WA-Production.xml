<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="BenchBase">
		<defName>WA_SutrasDesk</defName>
		<label>sutra desk</label>
		<description>A low writing desk for copying sutras by hand. Slow, exacting work that doubles as a place to study.</description>
		<thingClass>Building_ResearchBench</thingClass>
		<size>(2,1)</size>
		<rotatable>false</rotatable>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<RPC_JapanesePaper>20</RPC_JapanesePaper>
		</costList>
		<graphicData>
			<texPath>Things/Building/Furniture/WA-SutrasDesk</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(2,1)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2800</WorkToBuild>
			<Flammability>1.0</Flammability>
			<ResearchSpeedFactor>0.90</ResearchSpeedFactor>
			<Beauty>10</Beauty>
		</statBases>
		<fillPercent>0.2</fillPercent>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellIcon>WA_Zabuton_Dummy</interactionCellIcon>
		<designationCategory>WA_Builder</designationCategory>
		<surfaceType>Item</surfaceType>
		<comps>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>2.0</fuelConsumptionRate>
				<fuelCapacity>50.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>RPC_JapanesePaper</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>WA_Cassolette</li>
				</linkableFacilities>
			</li>
		</comps>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>WA_Research_Building_Funiture</li>
		</researchPrerequisites>

		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
	</ThingDef>


</Defs>