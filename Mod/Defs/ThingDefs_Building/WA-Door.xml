<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--========================= Fusuma =============================-->
  <ThingDef ParentName="BuildingBase" Name="WA_DoorBase" Abstract="True">
    <thingClass>Building_Door</thingClass>
    <category>Building</category>
    <altitudeLayer>DoorMoveable</altitudeLayer>
    <fillPercent>1</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>10</Beauty>
      <DoorOpenSpeed>10</DoorOpenSpeed>
      <WorkToBuild>300</WorkToBuild>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <soundImpactDefault>BulletImpact_Wood</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <drawerType>RealtimeOnly</drawerType>
    <building>
      <isInert>true</isInert>
      <canPlaceOverWall>true</canPlaceOverWall>
      <soundDoorOpenPowered>Door_OpenPowered</soundDoorOpenPowered>
      <soundDoorClosePowered>Door_ClosePowered</soundDoorClosePowered>
      <soundDoorOpenManual>Door_OpenManual</soundDoorOpenManual>
      <soundDoorCloseManual>Door_CloseManual</soundDoorCloseManual>
      <blueprintClass>Blueprint_Door</blueprintClass>
      <blueprintGraphicData>
        <texPath>Things/Building/Door/Door_Blueprint</texPath>
      </blueprintGraphicData>
    </building>
	<costList>
		<WoodLog>1</WoodLog>
		<RPC_JapanesePaper>3</RPC_JapanesePaper>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <placeWorkers>
      <li>PlaceWorker_DoorLearnOpeningSpeed</li>
    </placeWorkers>
    <designationCategory>WA_Builder</designationCategory>
	<researchPrerequisites>
	  <li>WA_Research_Building_Basic</li>
	</researchPrerequisites>
  </ThingDef>


  <!--========================= WA_FusumaBase =============================-->
  <ThingDef ParentName="WA_DoorBase" Name="WA_FusumaBase" Abstract="True">
    <label>Fusuma</label>
    <description>Fusuma is made by stretching paper and cloth on both sides of a framework made of wood and the like.\n
It is very light, so you can open and close quickly, but durability is low.\n
Although the sliding door has arrived in China, the sliding door is supposed to originate in Japan.\n
Originally it was originated "during lying" and began to be used as a partition of the bedroom.</description>
    <statBases>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Door/WA-Fusuma09_White</texPath>
    </graphicData>
	<designatorDropdown>Fusuma_Dropdown</designatorDropdown>
    <uiIconPath>Things/Building/Door/WA-Fusuma09_i</uiIconPath>
  </ThingDef>


