<Defs>

  <!-- ======================== Lighting ======================= -->
  <!-- ======================== WA_Glow_Toudai ======================= -->
  <ThingDef ParentName="ArtableFurnitureBase">
    <defName>WA_Glow_01Toudai</defName>
    <label>Cow dung lighthouse</label>
    <thingClass>Building_WorkTable</thingClass>
    <description>The lighthouse lights the light with a light on the lamp core soaked in "kerosene" produced from the animal's oil.
It is said that it began to be used around the Heian era, and it is said that the aristocratic group used to love mainly.
Cow dung lighthouse has been called by this name because its base part resembles the form of cow dung.</description>    
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Glow/WA-Glow-Toudai</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.35,0.35,0.3,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Glow/WA-Glow-Toudai</uiIconPath>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>8</pathCost>
    <constructEffect>ConstructWood</constructEffect>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.05</fillPercent>
    <statBases>
      <MaxHitPoints>25</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Beauty>1</Beauty>
      <Flammability>1.0</Flammability>
	  <Mass>5</Mass>
    </statBases>
    <selectable>true</selectable>
	<costList>
		<WoodLog>15</WoodLog>
	</costList>
	<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <placeWorkers>
      <li>PlaceWorker_Heater</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.2</fuelConsumptionRate>
        <fuelCapacity>40.0</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
            <li>Chemfuel</li>
			<li>RPC_Charcoal</li>
          </thingDefs>
        </fuelFilter>
        <destroyOnNoFuel>false</destroyOnNoFuel>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <heatPerSecond>3.5</heatPerSecond>
        <heatPushMaxTemperature>23</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.3</fireSize>
        <offset>(0.1,0,0.5)</offset>
      </li>
    </comps>
    <designationCategory>WA_Builder</designationCategory>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <researchPrerequisites>
      <li>WA_Research_Building_Funiture</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ======================== WA_Glow_Gatou ======================= -->
  <ThingDef ParentName="ArtableFurnitureBase">
    <defName>WA_Glow_02Gatou</defName>
    <label>Gato</label>
    <thingClass>Building_WorkTable</thingClass>
    <description>Gato is also a lighting fixture made from "kerosene" made from animal fat.
It began to be used around the Muromachi period, and it circulated enough to be used as a light source for the common people in the Edo period.
It is called a tile light because it makes it by baking it using the same soil as the Kawara.
It is one of the popular reasons to be flame retardant materials.</description>    
