<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <!--========================= WA_Koto =============================-->
	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>WA_Koto</defName>
		<label>Koto</label>
		<description>Koto is a thirteen-stringed musical instrumentsimilar to a zither.The stirngs stretch over an oblong board.</description>
		<graphicData>
			<texPath>Things/Building/Furniture/WA-Koto</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,1)</drawSize>
			<shadowData>
				<volume>(0.08,0.3,0.08)</volume>
			</shadowData>
			<damageData>
				<rect>(0.3,0.3,0.4,0.4)</rect>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<altitudeLayer>Building</altitudeLayer>
		<rotatable>true</rotatable>
		<socialPropernessMatters>true</socialPropernessMatters>
		<fillPercent>0.10</fillPercent>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<joyKind>Play_Music</joyKind>
		</building>
		<statBases>
			<MaxHitPoints>10</MaxHitPoints>
			<WorkToBuild>10000</WorkToBuild>
			<Mass>5</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>8</Beauty>
			<JoyGainFactor>2</JoyGainFactor>
		</statBases>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>80</costStuffCount>
		<costList>
			<Cloth>10</Cloth>
		</costList>
		<pathCost>70</pathCost>
		<passability>PassThroughOnly</passability>
		<designationCategory>WA_Builder</designationCategory>
		<researchPrerequisites>
			<li>WA_Research_Building_Amusement</li>
		</researchPrerequisites>
  </ThingDef>


