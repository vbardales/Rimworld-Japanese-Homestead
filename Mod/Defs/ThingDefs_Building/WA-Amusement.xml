  <!--========================= WA_Cassolette =============================-->
	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>WA_Cassolette</defName>
		<label>Cassolette</label>
		<description>An Cassolette is used to heat a perfume in a solid state and emit fragrance components.The nobility of the Heian period was a routine thing for men and women to be able to wear kimonos into incense burners and smell their bodies and clothes with scents.</description>
		<graphicData>
			<texPath>Things/Building/Furniture/WA-Cassolette</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(1,1)</drawSize>
			<shadowData>
				<volume>(0.08,0.3,0.08)</volume>
			</shadowData>
