<Defs>

	<!-- ===================== WA_DressingBase ===================== -->
	<ThingDef Abstract="True" Name="WA_DressingBase">
		<thingClass>Apparel</thingClass>
		<category>Item</category>
		<selectable>True</selectable>
		<pathCost>10</pathCost>
		<useHitPoints>True</useHitPoints>
		<drawGUIOverlay>true</drawGUIOverlay>
		<techLevel>Medieval</techLevel>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<recipeMaker>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
			<recipeUsers>
				<li>ElectricTailoringBench</li>
				<li>HandTailoringBench</li>
			</recipeUsers>
		</recipeMaker>
		<costList>
			<RPC_PureSilk>600</RPC_PureSilk>
		</costList>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToMake>10000</WorkToMake>
			<Mass>2.0</Mass>
			<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.25</ArmorRating_Sharp>
			<ArmorRating_Heat>0.25</ArmorRating_Heat>
			<Insulation_Cold>30</Insulation_Cold>
			<Insulation_Heat>30</Insulation_Heat>
      		<DeteriorationRate>3</DeteriorationRate>
			<Beauty>1</Beauty>
			<SellPriceFactor>0.75</SellPriceFactor>
			<Comfort>1.50</Comfort>
		</statBases>
		<altitudeLayer>Item</altitudeLayer>
		<alwaysHaulable>True</alwaysHaulable>
		<generateCommonality>0.001</generateCommonality>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li>
				<compClass>CompColorable</compClass>
			</li>
		</comps>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Neck</li>
			</bodyPartGroups>
			<tags>
				<li>Outlander</li>
			</tags>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<layers>
				<li>WA_Kimono</li>
			</layers>
		</apparel>
	    <thingCategories>
			<li>WA_Category_Dreassing</li>
	    </thingCategories>
	</ThingDef>

