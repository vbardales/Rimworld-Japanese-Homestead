	<!-- ===================== WA-Dressing-Princess ===================== -->
	<ThingDef ParentName="WA_DressingBase">
		<defName>WA_Dressing_Princess</defName>
		<label>Kimono-Princess</label>
		<description>Kimono of Princess.Princess' s dignity encourages surrounding friends.</description>
		<modExtensions>
			<li Class="WA.HediffAuraExtension">
				<enableOnlyPlayerFaction>true</enableOnlyPlayerFaction>
				<addHediffSeverity>0.5</addHediffSeverity>
				<maxHediffSeverity>1.0</maxHediffSeverity>
				<auraDistance>10.0</auraDistance>
				<auraTickInterval>1000</auraTickInterval>
				<hediffToAdd>HDA_Hediff_EncouragementOfThePrincess</hediffToAdd>
				<targetsEnemies>false</targetsEnemies>
			</li>
		</modExtensions>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/Princess/WA-Dressing-Princess</texPath>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<Beauty>10</Beauty>
		</statBases>
		<costList>
			<Gold>30</Gold>
		</costList>
		<equippedStatOffsets>
			<NegotiationAbility>0.3</NegotiationAbility>
			<TameAnimalChance>0.3</TameAnimalChance>
			<TrainAnimalChance>0.3</TrainAnimalChance>
			<Beauty>40</Beauty>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/Princess/WA-Dressing-Princess</wornGraphicPath>
		</apparel>
	</ThingDef>

	<!-- ===================== WA-Dressing-Sumoman ===================== -->
	<ThingDef ParentName="WA_DressingBase">
		<defName>WA_Dressing_Sumoman</defName>
		<label>Kimono-Rikishi</label>
		<description>Kimono of Rikishi.A Yokozuna with a mighty power overwhelms the enemy.</description>
		<modExtensions>
			<li Class="WA.HediffAuraExtension">
				<enableOnlyPlayerFaction>true</enableOnlyPlayerFaction>
