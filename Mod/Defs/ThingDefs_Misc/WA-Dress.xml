				<maxHediffSeverity>1.0</maxHediffSeverity>
				<auraDistance>15.0</auraDistance>
				<auraTickInterval>1000</auraTickInterval>
				<hediffToAdd>HDA_Hediff_IntimidateOfTheYokozuna</hediffToAdd>
				<targetsEnemies>true</targetsEnemies>
			</li>
		</modExtensions>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/Sumoman/WA-Dressing-Sumoman</texPath>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.45</ArmorRating_Sharp>
			<ArmorRating_Heat>0.45</ArmorRating_Heat>
			<Beauty>5</Beauty>
		</statBases>
		<costList>
			<Gold>30</Gold>
		</costList>
		<equippedStatOffsets>
			<PainShockThreshold>1.5</PainShockThreshold>
			<MentalBreakThreshold>-0.3</MentalBreakThreshold>
