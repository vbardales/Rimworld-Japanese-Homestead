<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>WA_Hediff_Metabolic</defName>
		<label>... A bit fat?</label>
		<description>One sweet too many. It shows.</description>
		<initialSeverity>1</initialSeverity>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.05</severityPerDay>
			</li>
			<li Class="HediffCompProperties_Discoverable">
				<sendLetterWhenDiscovered>true</sendLetterWhenDiscovered>
				<discoverLetterLabel>{0} was fat</discoverLetterLabel>
				<discoverLetterText>{0} is now Metabolic!</discoverLetterText>
				<letterType>PositiveEvent</letterType>
				<messageType>ThreatBig</messageType>
			</li>
		</comps>
		<stages>
			<li>
				<label>The magical power of sugar gradually corroves you.</label>
				<becomeVisible>false</becomeVisible>
			</li>
			<li>
				<label>The magical power of sugar gradually corroves you.</label>
				<minSeverity>0.7</minSeverity>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.20</offset>
					</li>
				</capMods>
				<statOffsets>
					<MeatAmount>20</MeatAmount>
					<EatingSpeed>0.10</EatingSpeed>
				</statOffsets>
			</li>
			<li>
				<label>The magical power of sugar gradually corroves you.</label>
				<minSeverity>1.0</minSeverity>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.40</offset>
					</li>
				</capMods>
				<statOffsets>
					<MeatAmount>40</MeatAmount>
					<EatingSpeed>0.20</EatingSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

